# Pick one or more providers. ARISE uses free routes first by default.

# OpenRouter supports many models through one OpenAI-compatible API.
OPENROUTER_API_KEY=your_openrouter_key_here
MODEL_NAME=meta-llama/llama-3.1-8b-instruct:free

# Optional Groq fallback.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FREE_TIER=true

# Optional custom OpenAI-compatible provider.
CUSTOM_OPENAI_NAME=custom
CUSTOM_OPENAI_API_KEY=your_key_here
CUSTOM_OPENAI_BASE_URL=https://example.com/v1
CUSTOM_OPENAI_MODEL=provider/model-name
CUSTOM_OPENAI_FREE_TIER=false

# Routing behavior.
ARISE_FREE_ONLY=true
ARISE_SHOW_ROUTE=false

# Optional task-specific model preferences.
# Use provider:model when the same model name could exist on multiple providers.
ARISE_DEFAULT_MODEL=
ARISE_FAST_MODEL=
ARISE_CODE_MODEL=
ARISE_REASONING_MODEL=
ARISE_CREATIVE_MODEL=

# Add extra free fallback models using provider:model, separated by commas.
ARISE_FREE_MODELS=openrouter:meta-llama/llama-3.1-8b-instruct:free

# Agent settings.
ARISE_TEMPERATURE=0.25
ARISE_MEMORY_FILE=arise_memory.json

# Enterprise cyber safety.
# review_only means ARISE reviews and plans; it does not execute production actions.
ARISE_SANDBOX_MODE=review_only
ARISE_REQUIRE_APPROVAL=true
ARISE_AUDIT_LOG=arise_audit.jsonl
